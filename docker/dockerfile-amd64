FROM nvcr.io/nvidia/tensorrt:24.04-py3

RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y \
    python3 \
    python3-pip \
    git

RUN pip3 install cmake --upgrade
WORKDIR /workspace

ENV CUDNN_DIR=/usr/local/cuda
ENV LD_LIBRARY_PATH=$CUDNN_DIR/lib64:$LD_LIBRARY_PATH

ENV CUDA_HOME=/usr/local/cuda
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH

RUN apt-get install libgtk* libspdlog-dev libfmt-dev libboost-dev ffmpeg libavformat-dev libavcodec-dev libswscale-dev pybind11-dev -y 

WORKDIR /workspace
# Pinned to a 4.x tag on purpose. These clones used to be unpinned, and once
# OpenCV's default branch moved to 5.x a rebuild silently installed OpenCV 5,
# which dropped the legacy C API headers. ROS Humble's cv_bridge includes
# opencv2/imgproc/types_c.h, so every package that pulls in cv_bridge stopped
# compiling. Bump this tag deliberately, never implicitly.
ARG OPENCV_VERSION=4.10.0
RUN git clone --branch ${OPENCV_VERSION} --depth 1 https://github.com/opencv/opencv.git \
    && git clone --branch ${OPENCV_VERSION} --depth 1 https://github.com/opencv/opencv_contrib.git \
    && cd opencv && mkdir build
WORKDIR /workspace/opencv/build
RUN cmake -D CMAKE_BUILD_TYPE=RELEASE \
    -D CUDA_CUDA_LIBRARY=/usr/local/cuda/lib64/stubs/libcuda.so \
    -D WITH_CUDA=ON \
    -D WITH_CUDNN=ON \
    -D OPENCV_DNN_CUDA=ON \
    -D ENABLE_FAST_MATH=1 \
    -D CUDA_FAST_MATH=1 \
    -D WITH_CUBLAS=1 \
    -D WITH_CUFFT=ON \
    -D WITH_CUBLAS=1 \
    -D WITH_NVCUVID=ON \
    -D BUILD_opencv_cudacodec=ON \
    -D CUDA_ARCH_BIN=8.9 \
    -D WITH_OPENGL=ON \
    -D WITH_NVCUVID=ON \
    -D WITH_FFMPEG=ON \
    -D WITH_GSTREAMER=ON \
    -D WITH_TBB=ON \
    -D BUILD_TESTS=OFF \
    -D BUILD_PERF_TESTS=OFF \
    -D BUILD_EXAMPLES=OFF \
    -D OPENCV_EXTRA_MODULES_PATH=/workspace/opencv_contrib/modules ..

RUN make -j$(nproc) && make install
RUN pip3 install torch torchvision --upgrade --force-reinstall

# Download resilience for the large pip and apt steps below. Builds here have
# failed repeatedly on read timeouts against files.pythonhosted.org and the ROS
# archive; without retries a single dropped connection discards the whole layer.
# Placed after the OpenCV and torch steps so a rebuild never recompiles OpenCV.
ENV PIP_DEFAULT_TIMEOUT=120
ENV PIP_RETRIES=10
RUN echo 'Acquire::Retries "10";' > /etc/apt/apt.conf.d/80-retries \
    && echo 'Acquire::http::Timeout "120";' >> /etc/apt/apt.conf.d/80-retries \
    && echo 'Acquire::https::Timeout "120";' >> /etc/apt/apt.conf.d/80-retries

RUN apt-get update && apt-get upgrade -y
RUN pip3 install onnxslim onnxruntime-gpu matplotlib tqdm requests psutil
RUN pip3 install "numpy<2"

WORKDIR /workspace
RUN apt-get update && apt-get install -y curl gnupg2 lsb-release
RUN curl -s https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc | gpg --dearmor > /usr/share/keyrings/ros-archive-keyring.gpg
RUN echo "deb [signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -sc) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null
RUN apt-get update && apt-get install -y ros-humble-desktop
RUN apt-get install -y python3-colcon-common-extensions python3-rosdep python3-rosinstall python3-vcstool

# Point every colcon build at the apt OpenCV that cv_bridge itself was built
# against. The CUDA-enabled build in /usr/local is for the TensorRT-side tooling;
# letting find_package(OpenCV) pick it up mixes two OpenCV ABIs in one process.
ENV OpenCV_DIR=/usr/lib/x86_64-linux-gnu/cmake/opencv4

# rosdep is the apt-installed script but runs against whatever setuptools pip
# left in /usr/local, which shadows the system one. The --upgrade pip installs
# earlier in this file pull setuptools past 81, where pkg_resources is gone, and
# rosdep dies with "ModuleNotFoundError: No module named 'pkg_resources'".
# Pin back to a version that still ships it.
RUN pip3 install "setuptools<81"

RUN rosdep init

# rosdep fetches the distro index over HTTP with its own short, non-configurable
# timeout. Container networking here reaches raw.githubusercontent.com roughly 8x
# slower than the host does, which trips that timeout on every attempt.
#
# This is not fatal for this image: the documented build path is `colcon build`,
# and nothing here or in the README invokes `rosdep install`. Failing a multi-GB
# image build on an optional metadata fetch is not worth it, so retry a few times
# and carry on with a loud warning if the index stays unreachable.
RUN for i in 1 2 3; do \
        rosdep update && break; \
        echo "rosdep update attempt $i failed"; \
        if [ "$i" = 3 ]; then \
            echo "WARNING: rosdep index unavailable; 'rosdep install' will not work"; \
            echo "WARNING: run 'rosdep update' inside the container before using it"; \
        fi; \
        sleep 10; \
    done; true




RUN apt-get install -y \
    libpcap-dev \
    python3-pip \
    libyaml-cpp-dev \
    libzmq3-dev \
    ros-humble-moveit* \
    ros-humble-cont* \
    ros-humble-ros2-cont* \
    ros-humble-bond* \
    ros-humble-diagnostic-updater* \
    ros-humble-nav2-common

RUN apt-get update && apt-get upgrade -y

