#!/usr/bin/env bash
# Live view of the bench IMU in RViz, inside the bizon_chess_player container: serial stream,
# Madgwick filter, RViz. Keep the IMU still for the first 2 s (gyro bias). Ctrl-C stops it; from
# another terminal use `docker stop -s INT bizon_imu_view`. A plain `docker stop` sends SIGTERM,
# which ends the nodes before they can turn the firmware's stream off.
#
# Usage: imu_view [ros2 launch args...]     e.g. imu_view port:=/dev/ttyACM1
#
# The node takes the serial port exclusively, so `joint_bench record` cannot run alongside it.
# Build first with: scripts/rosbuild --packages-select bizon_imu

set -euo pipefail

SELF="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
REPO="${BIZON_REPO:-$(dirname "$SELF")}"
COMPOSE="$REPO/docker/docker-compose-x86.yml"

# An image built before imu_tools joined docker/dockerfile-amd64 gets it here. It only lasts for
# this container; rebuilding the image makes the install step a no-op.
INNER='
  dpkg -s ros-humble-imu-tools >/dev/null 2>&1 || {
    echo "Installing ros-humble-imu-tools in this container..."
    apt-get update -qq && apt-get install -y -qq ros-humble-imu-tools >/dev/null
  }
  source /opt/ros/humble/setup.bash
  source ros_env/install/setup.bash
  exec ros2 launch bizon_imu imu_view.launch.py "$@"
'
exec docker compose -f "$COMPOSE" run --rm -T --name bizon_imu_view bizon_chess_player \
  bash -lc "$INNER" imu_view "$@"
