<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--xacro:include
    filename="$(find bizon_description)/urdf/bizon_mk1/bizon_system_interface.xacro" /-->

    <xacro:macro name="bizon_macro"
        params="prefix:=^|bizon/ port_id:=^|30200 ros2_control_hardware_type:=^|rviz controller:=^|false">


        <link name="${prefix}base_link">
            <visual>
                <origin rpy="1.57079632679 0.0 0.0" xyz="-0.150 0.070 0.0" />
                <geometry>
                    <mesh filename="package://bizon_description/meshes/base_link.stl"
                        scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
            <collision>
                <origin rpy="1.57079632679 0.0 0.0" xyz="-0.150 0.070 0.0" />
                <geometry>
                    <mesh filename="package://bizon_description/meshes/base_link.stl"
                        scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
            <inertial>
                <inertia ixx="0.00029" ixy="0.0" ixz="0.0" iyy="0.00029" iyz="0.0" izz="0.00052" />
                <origin rpy="1.57079632679 0.0 0.0" xyz="-0.150 0.070 0.0" />
                <mass value="1.00000" />
            </inertial>
        </link>

        <link name="${prefix}tower_link">
            <collision>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="package://bizon_description/meshes/link1.stl"
                        scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
            <inertial>
                <inertia ixx="0.02063" ixy="0.0" ixz="0.00004" iyy="0.02063" iyz="0.00001"
                    izz="0.00118" />
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
                <mass value="1.00000" />
            </inertial>
            <visual>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="package://bizon_description/meshes/link1.stl"
                        scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
        </link>

        <link name="${prefix}arm1_link">
            <collision>
                <origin rpy="1.57079632679 0 1.57079632679" xyz="-0.060 -0.060 0.0" />
                <geometry>
                    <mesh filename="package://bizon_description/meshes/link2.stl"
                        scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
            <inertial>
                <inertia ixx="0.00135" ixy="-0.00209" ixz="0.00002" iyy="0.00767" iyz="0.00001"
                    izz="0.00877" />
                <origin rpy="1.57079632679 0 1.57079632679" xyz="-0.060 -0.060 0.0" />
                <mass value="1.00000" />
            </inertial>
            <visual>
                <origin rpy="1.57079632679 0 1.57079632679" xyz="-0.060 -0.060 0.0" />
                <geometry>
                    <mesh filename="package://bizon_description/meshes/link2.stl"
                        scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
        </link>

        <link name="${prefix}arm2_link">
            <collision>
                <origin rpy="-1.57079632679 0.0 0.0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="package://bizon_description/meshes/link3.stl"
                        scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
            <inertial>
                <inertia ixx="0.00135" ixy="-0.00209" ixz="0.00002" iyy="0.00767" iyz="0.00001"
                    izz="0.00877" />
                <origin rpy="-1.57079632679 0.0 0.0" xyz="0.0 0.0 0.0" />
                <mass value="1.00000" />
            </inertial>
            <visual>
                <origin rpy="-1.57079632679 0.0 0.0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="package://bizon_description/meshes/link3.stl"
                        scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
        </link>

        <link name="${prefix}gripper_base_link">
            <visual>
                <origin rpy="0 0.0 0.0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="package://bizon_description/meshes/gripper_base.stl"
                        scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
            <collision>
                <origin rpy="0 0.0 0.0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="package://bizon_description/meshes/gripper_base.stl"
                        scale="0.001 0.001 0.001" />
                </geometry>
            </collision>
            <inertial>
                <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
                <origin rpy="0 0.0 0.0" xyz="0.0 0.0 0.0" />
                <mass value="1.000" />
            </inertial>
        </link>

        <link name="${prefix}gripper_finger1_link">
            <visual>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="package://bizon_description/meshes/gripper_finger_v2.stl"
                        scale="0.001 0.0015 0.001" />
                </geometry>
            </visual>
            <collision>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="package://bizon_description/meshes/gripper_finger_v2.stl"
                        scale="0.001 0.0015 0.001" />
                </geometry>
            </collision>
            <inertial>
                <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001" />
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
                <mass value="0.100" />
            </inertial>
        </link>

        <link name="${prefix}gripper_finger2_link">
            <visual>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="package://bizon_description/meshes/gripper_finger_v2.stl"
                        scale="0.001 0.0015 0.001" />
                </geometry>
            </visual>
            <collision>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="package://bizon_description/meshes/gripper_finger_v2.stl"
                        scale="0.001 0.0015 0.001" />
                </geometry>
            </collision>
            <inertial>
                <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001" />
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
                <mass value="0.100" />
            </inertial>
        </link>

        <link name="${prefix}gripper_finger3_link">
            <visual>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="package://bizon_description/meshes/gripper_finger_v2.stl"
                        scale="0.001 0.0015 0.001" />
                </geometry>
            </visual>
            <collision>
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
                <geometry>
                    <mesh filename="package://bizon_description/meshes/gripper_finger_v2.stl"
                        scale="0.001 0.0015 0.001" />
                </geometry>
            </collision>
            <inertial>
                <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001" />
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
                <mass value="0.100" />
            </inertial>
        </link>


        <joint name="${prefix}rev1" type="revolute">
            <limit lower="-3.14" upper="3.14" effort="0.0" velocity="12.56" />
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.045" />
            <parent link="${prefix}base_link" />
            <child link="${prefix}tower_link" />
            <axis xyz="0.0 0.0 1.00000" />
        </joint>

        <joint name="${prefix}pris1" type="prismatic">
            <limit lower="0.0" upper="0.28" effort="100.0" velocity="0.5" />
            <origin rpy="0.0 0.0 0.0" xyz="0 0 0.38" />
            <parent link="${prefix}tower_link" />
            <child link="${prefix}arm1_link" />
            <axis xyz="0.0 0.0 -1.0" />
        </joint>

        <joint name="${prefix}rev2" type="revolute">
            <limit lower="-3.14" upper="3.14" effort="0.0" velocity="12.56" />
            <origin rpy="0.0 0.0 0.0" xyz="0.29 0 -0.135" />
            <parent link="${prefix}arm1_link" />
            <child link="${prefix}arm2_link" />
            <axis xyz="0.0 0.0 1.0" />
        </joint>

        <joint name="${prefix}rev3" type="revolute">
            <limit effort="0.0" lower="-3.14" upper="3.14" velocity="12.56" />
            <origin rpy="3.1415 0.0 0.0" xyz="0.18 0.0 0.0" />
            <parent link="${prefix}arm2_link" />
            <child link="${prefix}gripper_base_link" />
            <axis xyz="0.0 0.0 1.0" />
        </joint>

        <joint name="${prefix}gripper_finger1_joint" type="revolute">
            <limit effort="5.0" lower="-0.06" upper="0.41" velocity="12.56" />
            <origin rpy="-1.57079632679 3.14159265359 0.0" xyz="0.015 0.0 0.035" />
            <parent link="${prefix}gripper_base_link" />
            <child link="${prefix}gripper_finger1_link" />
            <axis xyz="0.0 0.0 1.0" />
        </joint>

        <joint name="${prefix}gripper_finger2_joint" type="revolute">
            <limit effort="5.0" lower="-0.06" upper="0.41" velocity="12.56" />
            <origin rpy="-1.57079632679 -3.14159265359 2.09439510238" xyz="-0.0075 0.01299038105 0.035" />
            <parent link="${prefix}gripper_base_link" />
            <child link="${prefix}gripper_finger2_link" />
            <axis xyz="0.0 0.0 1.0" />
        </joint>

        <joint name="${prefix}gripper_finger3_joint" type="revolute">
            <limit effort="5.0" lower="-0.06" upper="0.41" velocity="12.56" />
            <origin rpy="-1.57079632679 -3.14159265359 -2.09439510238" xyz="-0.0075 -0.01299038105 0.035" />
            <parent link="${prefix}gripper_base_link" />
            <child link="${prefix}gripper_finger3_link" />
            <axis xyz="0.0 0.0 1.0" />
        </joint>

    </xacro:macro>


</robot>